---
import BaseLayout from '../../layouts/BaseLayout.astro'; import Breadcrumbs from '../../components/Breadcrumbs.astro'; import RelatedTools from '../../components/RelatedTools.astro'; import RelatedGuides from '../../components/RelatedGuides.astro'; import JsonLd from '../../components/seo/JsonLd.astro'; import { absoluteUrl } from '../../config';
const title = 'Mouse Wheel Not Scrolling: What to Check'; const description = 'Troubleshoot a mouse wheel that does not scroll with a repeatable browser test and connection checks.';
const guides = [{href:'/guides/mouse-wheel-skips',title:'Mouse Wheel Skips',description:'Check an intermittent or jumping wheel.'},{href:'/guides/mouse-wheel-lagging',title:'Mouse Wheel Lagging',description:'Isolate delayed scroll input.'}];
---
<BaseLayout {title} {description} path="/guides/mouse-wheel-not-scrolling" type="article"><JsonLd data={{'@context':'https://schema.org','@type':'Article',headline:title,description,url:absoluteUrl('/guides/mouse-wheel-not-scrolling')}}/><Breadcrumbs items={[{label:'Guides',href:'/guides/how-to-test-mouse-wheel'},{label:'Mouse Wheel Not Scrolling'}]}/><article class="content"><h1>{title}</h1><p class="lead">When the wheel does nothing, first determine whether the browser receives any scroll events before changing multiple settings at once.</p><h2>Run the scroll wheel test</h2><p>Open the <a href="/">Scroll Wheel Test</a>, place the pointer in the test area, and roll the wheel in both directions. If neither direction is detected, reconnect the mouse, charge it or replace its battery, and try a different USB port or receiver position.</p><h2>Separate a mouse issue from a software issue</h2><p>Test in another browser and, if possible, on another computer. A wheel that works elsewhere points toward software, accessibility settings, or a particular application. A wheel that never sends input across devices is more likely related to the mouse, receiver, cable, or power.</p><h2>Check settings after a baseline</h2><p>Review manufacturer utilities and operating-system mouse settings after the simple comparisons. Avoid spraying liquid into the wheel; use only the cleaning method recommended by the manufacturer.</p><RelatedGuides {guides}/><RelatedTools current="wheel"/></article></BaseLayout>
