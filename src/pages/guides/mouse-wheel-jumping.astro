import BaseLayout from '../../layouts/BaseLayout.astro'; import Breadcrumbs from '../../components/Breadcrumbs.astro'; import RelatedTools from '../../components/RelatedTools.astro'; import JsonLd from '../../components/seo/JsonLd.astro'; import { absoluteUrl } from '../../config'; const title='Why Is My Mouse Wheel Jumping Up and Down?'; const description='Learn what scroll wheel jumping can mean and how to isolate hardware, connection, and software causes.';
