---
import BaseLayout from '../../layouts/BaseLayout.astro'; import Breadcrumbs from '../../components/Breadcrumbs.astro'; import RelatedTools from '../../components/RelatedTools.astro'; import RelatedGuides from '../../components/RelatedGuides.astro'; import JsonLd from '../../components/seo/JsonLd.astro'; import { absoluteUrl } from '../../config';
const title = 'How to Test a Mouse'; const description = 'A practical browser-based process for checking mouse buttons, scrolling, and input timing.';
const guides = [{href:'/guides/mouse-double-clicks-on-single-click',title:'Mouse Double Clicks on a Single Click',description:'Troubleshoot accidental repeated input.'},{href:'/guides/why-is-my-mouse-polling-rate-low',title:'Why Is My Mouse Polling Rate Low?',description:'Interpret a lower event-rate estimate.'}];
---
<BaseLayout {title} {description} path="/guides/how-to-test-a-mouse" type="article"><JsonLd data={{'@context':'https://schema.org','@type':'Article',headline:title,description,url:absoluteUrl('/guides/how-to-test-a-mouse')}}/><Breadcrumbs items={[{label:'Guides'},{label:'How to Test a Mouse'}]}/><article class="content"><h1>{title}</h1><p class="lead">A useful mouse check begins by confirming the basic inputs, then testing the one symptom that feels wrong.</p><h2>Check the common controls</h2><p>Start with the <a href="/mouse-test">Mouse Test</a> to verify buttons, movement, and both scroll directions. Make a calm pass and note which controls are missing or inconsistent.</p><h2>Use a focused follow-up</h2><p>For unexpected repeat input, run the <a href="/double-click-test">Double Click Test</a>. For wheel direction or skips, use the <a href="/">Scroll Wheel Test</a>. For movement-event timing, use the <a href="/mouse-polling-rate-test">Mouse Polling Rate Test</a>.</p><h2>Compare one condition at a time</h2><p>Try another browser, USB port, receiver placement, or computer before making hardware conclusions. A result that follows the mouse is more useful than a symptom that appears only in one program.</p><RelatedGuides {guides}/><RelatedTools current="mouse"/></article></BaseLayout>
