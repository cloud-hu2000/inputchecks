---
import BaseLayout from '../layouts/BaseLayout.astro'; import ReactionTool from '../components/ReactionTool.astro'; import RelatedTools from '../components/RelatedTools.astro'; import Breadcrumbs from '../components/Breadcrumbs.astro'; import FAQ from '../components/FAQ.astro'; import JsonLd from '../components/seo/JsonLd.astro'; import { absoluteUrl } from '../config';
const description = 'Take a free reaction time test to measure visual response in milliseconds, compare several rounds, and understand how device and focus affect results.';
const faq = [{question:'Is this an exact measurement?',answer:'It measures the time between this page changing color and your browser receiving a click, so device and browser latency can affect it.'},{question:'Why do I get different scores?',answer:'Reaction time naturally varies with attention, fatigue, anticipation, and the timing of each round.'}];
---
<BaseLayout title="Reaction Time Test – Measure Reaction Speed" {description} path="/reaction-time-test"><JsonLd data={{'@context':'https://schema.org','@type':'WebApplication',name:'Reaction Time Test',url:absoluteUrl('/reaction-time-test'),applicationCategory:'UtilitiesApplication',operatingSystem:'Any',offers:{'@type':'Offer',price:'0',priceCurrency:'USD'}}}/><Breadcrumbs items={[{label:'Reaction Time Test'}]}/><section class="page-hero shell compact"><h1>Reaction Time Test</h1><p>Measure the time between a visual cue and your click.</p></section><ReactionTool/><article class="content"><h2>How to use this reaction time test</h2><p>Click the panel to start, wait without anticipating, and click only after it turns green. The test records milliseconds from the color change to the click received by the page. Complete a few rounds and compare your best and typical results rather than giving one result too much weight.</p><h2>What affects a reaction time result?</h2><p>Attention, fatigue, input device, display and browser timing, and how closely you anticipate the cue all matter. An early click is deliberately excluded because it is not a response to the cue. The result is useful for casual comparison, not a medical or performance diagnosis.</p><p>Want to practice click speed separately? Try the <a href="/cps-test">CPS test</a>. If your click itself feels unreliable, use the <a href="/double-click-test">double click test</a>.</p><RelatedTools current="reaction"/><FAQ items={faq}/></article></BaseLayout>
