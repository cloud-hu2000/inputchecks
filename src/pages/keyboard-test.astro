---
import BaseLayout from '../layouts/BaseLayout.astro'; import KeyboardTool from '../components/KeyboardTool.astro'; import RelatedTools from '../components/RelatedTools.astro'; import Breadcrumbs from '../components/Breadcrumbs.astro'; import FAQ from '../components/FAQ.astro'; import JsonLd from '../components/seo/JsonLd.astro'; import { absoluteUrl } from '../config';
const description = 'Use this free keyboard test to check individual keys in your browser, view each detected key code, and troubleshoot a key that seems unresponsive.';
const faq = [{question:'Why is a key not detected?',answer:'The page must be focused first. System and browser shortcuts can also be captured before they reach the test.'},{question:'Does this diagnose a broken keyboard?',answer:'No. It reports browser-visible key events and is best used as a repeatable first check.'}];
---
<BaseLayout title="Keyboard Test – Check Keyboard Keys Online" {description} path="/keyboard-test"><JsonLd data={{'@context':'https://schema.org','@type':'WebApplication',name:'Keyboard Test',url:absoluteUrl('/keyboard-test'),applicationCategory:'UtilitiesApplication',operatingSystem:'Any',offers:{'@type':'Offer',price:'0',priceCurrency:'USD'}}}/><Breadcrumbs items={[{label:'Keyboard Test'}]}/><section class="page-hero shell compact"><h1>Keyboard Test</h1><p>Check whether individual keyboard presses reach this browser tab.</p></section><KeyboardTool/><article class="content"><h2>How to test keyboard keys</h2><p>Click inside the test panel so it has focus, then press each key you want to check. The page records the key label and browser key code, along with how many distinct keys it has seen. Test slowly first, especially if you are checking one key that feels inconsistent.</p><h2>Understand keyboard test results</h2><p>A detected key means the browser received that press. It does not rule out a problem in a game, an application shortcut, a keyboard layout, a cable, or an operating-system setting. If one key never appears, try another browser or computer before deciding that the switch has failed.</p><p>To test combinations rather than individual keys, open the <a href="/keyboard-ghosting-test">keyboard ghosting test</a>. For the most-used long key, use the dedicated <a href="/spacebar-test">spacebar test</a>.</p><RelatedTools current="keyboard"/><FAQ items={faq}/></article></BaseLayout>
