---
import BaseLayout from '../layouts/BaseLayout.astro'; import MouseTool from '../components/MouseTool.astro'; import RelatedTools from '../components/RelatedTools.astro'; import Breadcrumbs from '../components/Breadcrumbs.astro'; import JsonLd from '../components/seo/JsonLd.astro'; import { absoluteUrl } from '../config'; const description='Check mouse buttons, scroll wheel directions and movement with this free interactive mouse test.';
---
<BaseLayout title="Mouse Test – Check Mouse Buttons & Scroll Wheel" {description} path="/mouse-test"><JsonLd data={{'@context':'https://schema.org','@type':'WebApplication',name:'Mouse Test',url:absoluteUrl('/mouse-test'),applicationCategory:'UtilitiesApplication',operatingSystem:'Any',offers:{'@type':'Offer',price:'0',priceCurrency:'USD'}}}/><Breadcrumbs items={[{label:'Mouse Test'}]}/><section class="page-hero shell compact"><p class="eyebrow">Mouse input utility</p><h1>Mouse Test</h1><p>Check buttons, scroll directions, and pointer movement in one place.</p></section><MouseTool/><article class="content"><h2>How this mouse test works</h2><p>Use the large test area naturally. Each available button and movement signal is marked when your browser receives it. Some mice do not have Back or Forward buttons, so those checks may remain waiting.</p><RelatedTools current="mouse"/></article></BaseLayout>
