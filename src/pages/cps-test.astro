---
import BaseLayout from '../layouts/BaseLayout.astro'; import CpsTool from '../components/CpsTool.astro'; import RelatedTools from '../components/RelatedTools.astro'; import Breadcrumbs from '../components/Breadcrumbs.astro'; import FAQ from '../components/FAQ.astro'; import JsonLd from '../components/seo/JsonLd.astro'; import { absoluteUrl } from '../config';
const description = 'Run a free five-second CPS test to measure clicks per second, compare repeatable mouse or trackpad results, and understand what affects click speed.';
const faq = [{question:'How is CPS calculated?',answer:'The completed score is the number of clicks recorded during the five-second round divided by five.'},{question:'Can I use a trackpad?',answer:'Yes. The test counts browser clicks from a mouse or trackpad.'}];
---
<BaseLayout title="CPS Test – Clicks Per Second Test" {description} path="/cps-test"><JsonLd data={[{'@context':'https://schema.org','@type':'WebApplication',name:'CPS Test',url:absoluteUrl('/cps-test'),applicationCategory:'UtilitiesApplication',operatingSystem:'Any',offers:{'@type':'Offer',price:'0',priceCurrency:'USD'}},{'@context':'https://schema.org','@type':'FAQPage',mainEntity:faq.map((item)=>({'@type':'Question',name:item.question,acceptedAnswer:{'@type':'Answer',text:item.answer}}))}]}/><Breadcrumbs items={[{label:'CPS Test'}]}/><section class="page-hero shell compact"><h1>CPS Test</h1><p>Measure your click speed with a focused five-second clicks-per-second test.</p></section><CpsTool/><article class="content"><h2>How to use this CPS test</h2><p>Click the target once to begin, then make comfortable, controlled clicks until the five-second round completes. Your result is the total clicks divided by the fixed five-second duration. Compare repeatable runs rather than trying to reach a single number with an uncomfortable technique.</p><h2>What affects clicks per second?</h2><p>Grip, button feel, fatigue, trackpad versus mouse input, and the clicking method all affect a CPS result. This page measures click events that reach the browser; it is a quick practice and comparison tool, not a measure of mouse hardware quality.</p><p>If clicks seem to register twice during a normal sample, use the <a href="/double-click-test">double click test</a>. For a broader hardware check, run the <a href="/mouse-test">mouse test</a>.</p><RelatedTools current="cps"/><FAQ items={faq}/></article></BaseLayout>
