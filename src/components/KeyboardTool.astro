<section class="tester keyboard-tester" data-keyboard-tester><button type="button" class="keyboard-zone" data-keyboard-zone aria-label="Keyboard test area"><strong data-keyboard-last>Click here, then press a key</strong><small data-keyboard-code>No input received yet</small></button><div class="metrics four" aria-live="polite"><div><span>Keys detected</span><strong data-keyboard-count>0</strong></div><div><span>Last key</span><strong data-keyboard-value>—</strong></div><div><span>Key code</span><strong data-keyboard-keycode>—</strong></div><div><span>Status</span><strong data-keyboard-status>Ready</strong></div></div><p class="callout">Some system shortcuts, media keys, and browser shortcuts may be intercepted before this page can see them.</p><button class="button text-button" data-keyboard-reset>Reset test</button></section>
<script>
  const tester = document.querySelector<HTMLElement>('[data-keyboard-tester]');
  if (tester) { const zone = tester.querySelector<HTMLElement>('[data-keyboard-zone]')!; const last = tester.querySelector<HTMLElement>('[data-keyboard-last]')!; const code = tester.querySelector<HTMLElement>('[data-keyboard-code]')!; const count = tester.querySelector<HTMLElement>('[data-keyboard-count]')!; const value = tester.querySelector<HTMLElement>('[data-keyboard-value]')!; const keycode = tester.querySelector<HTMLElement>('[data-keyboard-keycode]')!; const status = tester.querySelector<HTMLElement>('[data-keyboard-status]')!; let keys = new Set<string>();
    const handle = (event: KeyboardEvent) => { if (event.repeat) return; keys.add(event.code); last.textContent = event.key === ' ' ? 'Space' : event.key; code.textContent = event.code; count.textContent = String(keys.size); value.textContent = event.key === ' ' ? 'Space' : event.key; keycode.textContent = event.code; status.textContent = 'Detected'; };
    zone.addEventListener('keydown', handle); zone.addEventListener('click', () => zone.focus()); tester.querySelector('[data-keyboard-reset]')?.addEventListener('click', () => { keys = new Set(); last.textContent = 'Click here, then press a key'; code.textContent = 'No input received yet'; count.textContent = '0'; value.textContent = '—'; keycode.textContent = '—'; status.textContent = 'Ready'; zone.focus(); }); }
</script>
