<section class="tester spacebar-tester" data-spacebar-tester><button type="button" class="keyboard-zone spacebar-zone" data-spacebar-zone aria-label="Spacebar test area"><strong data-spacebar-message>Click here, then press Space</strong><small>The panel flashes each time a non-repeat Space keydown is received.</small></button><div class="metrics four" aria-live="polite"><div><span>Space presses</span><strong data-spacebar-count>0</strong></div><div><span>Last press</span><strong data-spacebar-time>—</strong></div><div><span>Key code</span><strong data-spacebar-code>—</strong></div><div><span>Status</span><strong data-spacebar-status>Ready</strong></div></div><p class="callout">Holding the bar down can trigger your system’s key-repeat behavior. This counter records only the first keydown of each press.</p><button class="button text-button" data-spacebar-reset>Reset test</button></section>
<script>
  const tester = document.querySelector<HTMLElement>('[data-spacebar-tester]');
  if (tester) { const zone = tester.querySelector<HTMLElement>('[data-spacebar-zone]')!; const message = tester.querySelector<HTMLElement>('[data-spacebar-message]')!; const count = tester.querySelector<HTMLElement>('[data-spacebar-count]')!; const time = tester.querySelector<HTMLElement>('[data-spacebar-time]')!; const code = tester.querySelector<HTMLElement>('[data-spacebar-code]')!; const status = tester.querySelector<HTMLElement>('[data-spacebar-status]')!; let presses = 0;
    zone.addEventListener('keydown', (e) => { if (e.code !== 'Space') return; e.preventDefault(); if (e.repeat) return; presses++; count.textContent = String(presses); time.textContent = new Date().toLocaleTimeString(); code.textContent = e.code; status.textContent = 'Detected'; message.textContent = 'Space detected ✓'; zone.classList.add('key-active'); window.setTimeout(() => zone.classList.remove('key-active'), 150); }); zone.addEventListener('click', () => zone.focus()); tester.querySelector('[data-spacebar-reset]')?.addEventListener('click', () => { presses = 0; count.textContent = '0'; time.textContent = '—'; code.textContent = '—'; status.textContent = 'Ready'; message.textContent = 'Click here, then press Space'; zone.focus(); }); }
</script>
