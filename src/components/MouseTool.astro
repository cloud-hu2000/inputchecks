<section class="tester mouse-tester" data-mouse-tester><div class="mouse-zone" tabindex="0" aria-label="Mouse test area"><div class="mouse-zone-content"><div class="mouse-visual" aria-hidden="true"><i data-mouse-part="left"></i><i data-mouse-part="right"></i><i data-mouse-part="middle"></i><i data-mouse-part="back"></i><i data-mouse-part="forward"></i></div><span>Move, click, and scroll here</span></div></div><strong class="progress" data-progress>0 / 8 checks detected</strong><div class="check-grid">{[['left','Left Button'],['right','Right Button'],['middle','Middle Button'],['back','Back Button'],['forward','Forward Button'],['scroll-up','Scroll Up'],['scroll-down','Scroll Down'],['movement','Mouse Movement']].map(([key,label]) => <div class="check" data-status={key}><span>{label}</span><b>Waiting</b></div>)}</div><button class="button text-button" data-mouse-reset>Reset test</button></section><script src="../tools/mouse-buttons/MouseTester.ts"></script>
