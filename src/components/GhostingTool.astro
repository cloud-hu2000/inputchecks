<section class="tester ghosting-tester" data-ghosting-tester><button type="button" class="keyboard-zone ghosting-zone" data-ghosting-zone aria-label="Keyboard ghosting test area"><strong data-ghosting-message>Click here and hold multiple keys</strong><small>Try the keys marked below, then release them.</small><span class="key-grid" aria-hidden="true">{['W','A','S','D','Q','E','R','F','Space'].map((key) => <span data-key={key}>{key}</span>)}</span></button><div class="metrics four" aria-live="polite"><div><span>Keys held now</span><strong data-ghosting-current>0</strong></div><div><span>Most held together</span><strong data-ghosting-peak>0</strong></div><div><span>Last combination</span><strong data-ghosting-last>—</strong></div><div><span>Status</span><strong data-ghosting-status>Ready</strong></div></div><p class="callout">This shows keys the browser receives. It cannot prove a keyboard fault, because keyboard layouts, operating systems, and shortcuts can affect combinations.</p><button class="button text-button" data-ghosting-reset>Reset test</button></section>
<script>
  const tester = document.querySelector<HTMLElement>('[data-ghosting-tester]');
  if (tester) { const zone = tester.querySelector<HTMLElement>('[data-ghosting-zone]')!; const current = tester.querySelector<HTMLElement>('[data-ghosting-current]')!; const peak = tester.querySelector<HTMLElement>('[data-ghosting-peak]')!; const last = tester.querySelector<HTMLElement>('[data-ghosting-last]')!; const status = tester.querySelector<HTMLElement>('[data-ghosting-status]')!; const message = tester.querySelector<HTMLElement>('[data-ghosting-message]')!; let held = new Set<string>(), highest = 0;
    const label = (e: KeyboardEvent) => e.code === 'Space' ? 'Space' : e.key.length === 1 ? e.key.toUpperCase() : e.key;
    const update = () => { const labels = [...held]; current.textContent = String(labels.length); last.textContent = labels.join(' + ') || '—'; highest = Math.max(highest, labels.length); peak.textContent = String(highest); status.textContent = labels.length ? 'Detecting' : highest ? 'Released' : 'Ready'; message.textContent = labels.length ? labels.join(' + ') : 'Click here and hold multiple keys'; tester.querySelectorAll<HTMLElement>('[data-key]').forEach((node) => node.classList.toggle('active', held.has(node.dataset.key!))); };
    zone.addEventListener('keydown', (e) => { e.preventDefault(); held.add(label(e)); update(); }); zone.addEventListener('keyup', (e) => { e.preventDefault(); held.delete(label(e)); update(); }); zone.addEventListener('click', () => zone.focus()); window.addEventListener('blur', () => { held.clear(); update(); }); tester.querySelector('[data-ghosting-reset]')?.addEventListener('click', () => { held.clear(); highest = 0; update(); zone.focus(); }); }
</script>
