---
const { label = 'Advertisement', slot } = Astro.props;
const client = import.meta.env.PUBLIC_ADSENSE_CLIENT_ID;
---
<aside class="ad-slot" aria-label={label}><span>{label}</span>{client && <ins class="adsbygoogle" style="display:block" data-ad-client={client} data-ad-slot={slot} data-ad-format="auto" data-full-width-responsive="true"></ins>}</aside>
