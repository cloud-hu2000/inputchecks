---
interface Crumb { label: string; href?: string }
const { items } = Astro.props as { items: Crumb[] };
---
<nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a>{items.map((item) => <><span aria-hidden="true">/</span>{item.href ? <a href={item.href}>{item.label}</a> : <span aria-current="page">{item.label}</span>}</>)}</nav>
