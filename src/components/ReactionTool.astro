<section class="tester reaction-tester" data-reaction-tester><button class="reaction-zone" data-reaction-zone aria-label="Start reaction time test"><strong data-reaction-message>Click to start</strong><small data-reaction-detail>A color change will follow in 2–5 seconds.</small></button><div class="metrics four" aria-live="polite"><div><span>Latest time</span><strong data-reaction-latest>—</strong></div><div><span>Best time</span><strong data-reaction-best>—</strong></div><div><span>Rounds</span><strong data-reaction-rounds>0</strong></div><div><span>Status</span><strong data-reaction-status>Ready</strong></div></div><button class="button text-button" data-reaction-reset>Reset results</button></section>
<script>
  const tester = document.querySelector<HTMLElement>('[data-reaction-tester]');
  if (tester) { const zone = tester.querySelector<HTMLButtonElement>('[data-reaction-zone]')!; const message = tester.querySelector<HTMLElement>('[data-reaction-message]')!; const detail = tester.querySelector<HTMLElement>('[data-reaction-detail]')!; const latest = tester.querySelector<HTMLElement>('[data-reaction-latest]')!; const best = tester.querySelector<HTMLElement>('[data-reaction-best]')!; const rounds = tester.querySelector<HTMLElement>('[data-reaction-rounds]')!; const status = tester.querySelector<HTMLElement>('[data-reaction-status]')!; let state: 'ready'|'waiting'|'go' = 'ready', timer = 0, started = 0, count = 0, bestTime = Infinity;
    const ready = (text = 'Click to start') => { state = 'ready'; zone.classList.remove('waiting','go','early'); message.textContent = text; detail.textContent = 'A color change will follow in 2–5 seconds.'; status.textContent = 'Ready'; };
    zone.addEventListener('click', () => { if (state === 'ready') { state = 'waiting'; zone.classList.add('waiting'); message.textContent = 'Wait for green…'; detail.textContent = 'Do not click yet.'; status.textContent = 'Waiting'; timer = window.setTimeout(() => { state = 'go'; started = performance.now(); zone.classList.remove('waiting'); zone.classList.add('go'); message.textContent = 'Click now!'; detail.textContent = 'React as quickly as you can.'; status.textContent = 'Go'; }, 2000 + Math.random() * 3000); return; } if (state === 'waiting') { window.clearTimeout(timer); zone.classList.remove('waiting'); zone.classList.add('early'); message.textContent = 'Too soon'; detail.textContent = 'Wait for green on the next round.'; status.textContent = 'Early click'; window.setTimeout(() => ready(), 1000); return; } const result = Math.round(performance.now() - started); count++; bestTime = Math.min(bestTime, result); latest.textContent = `${result} ms`; best.textContent = `${bestTime} ms`; rounds.textContent = String(count); ready(`${result} ms — click for another round`); });
    tester.querySelector('[data-reaction-reset]')?.addEventListener('click', () => { window.clearTimeout(timer); count = 0; bestTime = Infinity; latest.textContent = '—'; best.textContent = '—'; rounds.textContent = '0'; ready(); }); }
</script>
